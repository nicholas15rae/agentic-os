# Agentic OS / Command Center — repo-root .env template.
# Copy to .env and fill in what you use. .env is gitignored; this file holds no values.
# The Command Center reads these fresh on every call (no restart needed); env vars win over .env.

# ── Voice ────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Spotify (Settings → Integrations → Spotify) ──────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# ── Search / mail / models ───────────────────────────────
BRAVE_API_KEY=
GMAIL_SCRIPT_ID=
GMAIL_SCRIPT_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Instagram API with Instagram Login (graph.instagram.com, v26.0) ──
# Long-lived (60-day) token for your Instagram Professional account. Required for the
# Instagram tools; the app renews it automatically before it expires. Never sent to the UI.
INSTAGRAM_ACCESS_TOKEN=
# Optional: your Meta app's Instagram app id / secret. When the secret is set, the
# server.py webhook (/webhook/instagram) rejects POSTs without a valid X-Hub-Signature-256.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Webhook verify token you paste into the Meta Developer Portal (any long random string).
INSTAGRAM_VERIFY_TOKEN=

# ── Maps (OpenStreetMap: OpenFreeMap tiles, Nominatim, OSRM — no key needed) ──
# Optional: where "how long to get to …" starts. An address or "lat,lng".
# Unset = Toronto city centre.
MAP_HOME=

# ── IBKR paper trading (trading/ibkr_bridge.py, ib_async) ─────────────
# PAPER is the only mode this build will dial. LIVE stays LOCKED even with
# ALLOW_LIVE_EXECUTION=TRUE until a reviewed code change enables it.
TRADING_MODE=PAPER
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=7497
IBKR_LIVE_PORT=7496
ALLOW_LIVE_EXECUTION=FALSE
# One TWS client id per worker (never 0 — that's the TWS master client).
IBKR_CLIENT_ID_BRIDGE=11
IBKR_CLIENT_ID_DATA=12
IBKR_CLIENT_ID_EXEC=13
IBKR_CLIENT_ID_KILL=19
# 1 live, 2 frozen, 3 delayed, 4 delayed-frozen
IBKR_MARKET_DATA_TYPE=3
# Bridge HTTP (127.0.0.1 only); the gateway proxies it at /api/trading/*.
TRADING_BRIDGE_PORT=8091
TRADING_BRIDGE_AUTOSTART=1

# ── Trading intel: Discord (trading/discord_live.py, discord_ingest.py) ──
# A BOT token only (Developer Portal → Bot; enable the MESSAGE CONTENT intent; a server admin
# adds the bot with View Channel + Read Message History). User tokens are not supported.
DISCORD_BOT_TOKEN=
# The two trading channels (comma-separated ids). History imports are filtered to these too.
DISCORD_TRADING_CHANNEL_IDS=
DISCORD_POLL_SECONDS=60
# History: export with DiscordChatExporter (JSON) into data/trading/discord/inbox/, then Import.
