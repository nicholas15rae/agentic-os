# Agentic OS / Command Center — repo-root .env template.
# Copy to .env and fill in what you use. .env is gitignored; this file holds no values.
# The Command Center reads these fresh on every call (no restart needed); env vars win over .env.

# ── Voice ────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Spotify (Settings → Integrations → Spotify) ──────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# ── Search / mail / models ───────────────────────────────
BRAVE_API_KEY=
GMAIL_SCRIPT_ID=
GMAIL_SCRIPT_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Instagram API with Instagram Login (graph.instagram.com, v26.0) ──
# Long-lived (60-day) token for your Instagram Professional account. Required for the
# Instagram tools; the app renews it automatically before it expires. Never sent to the UI.
INSTAGRAM_ACCESS_TOKEN=
# Optional: your Meta app's Instagram app id / secret. When the secret is set, the
# server.py webhook (/webhook/instagram) rejects POSTs without a valid X-Hub-Signature-256.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Webhook verify token you paste into the Meta Developer Portal (any long random string).
INSTAGRAM_VERIFY_TOKEN=

# ── Maps (OpenStreetMap: OpenFreeMap tiles, Nominatim, OSRM — no key needed) ──
# Optional: where "how long to get to …" starts. An address or "lat,lng".
# Unset = Toronto city centre.
MAP_HOME=
